NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# R01 身份与会话（生产环境自动关闭演示身份）
# QTB_DEMO_MODE=1           # 仅非生产环境可开；生产置 1 会拒绝启动
# QTB_SESSION_TTL_MS=604800000
# QTB_SECURE_COOKIES=1      # 生产默认开启
# QTB_EMAIL_RECOVERY=0      # 未配置邮件服务时保持 0，账户恢复能力显式关闭

# 演示租户白名单（真实账户不受此白名单限制）
# QTB_TENANTS=tenant_demo
# QTB_DEFAULT_TENANT=tenant_demo
# QTB_INITIAL_CREDITS=240
