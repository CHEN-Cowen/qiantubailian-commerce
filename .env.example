NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# R01 身份与会话（生产环境自动关闭演示身份）
# QTB_DEMO_MODE=1           # 仅非生产环境可开；生产置 1 会拒绝启动
# QTB_SESSION_TTL_MS=604800000
# QTB_SECURE_COOKIES=1      # 生产默认开启
# QTB_EMAIL_RECOVERY=0      # 未配置邮件服务时保持 0，账户恢复能力显式关闭

# 演示租户白名单（真实账户不受此白名单限制）
# QTB_TENANTS=tenant_demo
# QTB_DEFAULT_TENANT=tenant_demo
# QTB_INITIAL_CREDITS=240

# 图像 / OCR（默认模拟；没有密钥不调用外部服务）
QTB_PROVIDER=mock
# PARATERA_API_KEY=
# QTB_SEEDREAM_POST_COMPOSITE=1
# QTB_OCR_ENDPOINT=
# QTB_OCR_API_KEY=
# QTB_OCR_MODEL=
# QTB_OCR_TIMEOUT_MS=15000

# 支付：当前没有商户资质，保持关闭
QTB_PAYMENT_PROVIDER=none
QTB_ENABLE_REAL_PAYMENTS=0
# QTB_WX_MCHID=
# QTB_WX_APPID=
# QTB_WX_APIV3_KEY=           # 原始 32 字节 APIv3 密钥，不是十六进制摘要
# QTB_WX_PRIVATE_KEY=         # PEM；环境变量中的字面量 \n 会转换为换行
# QTB_WX_SERIAL_NO=           # 商户 API 证书序列号
# QTB_WX_PLATFORM_CERT=       # 平台证书或平台公钥 PEM
# QTB_WX_PLATFORM_SERIAL=     # 平台证书序列号或平台公钥 ID
# QTB_WX_NOTIFY_URL=https://your-domain.example/api/billing/wechat/notify
