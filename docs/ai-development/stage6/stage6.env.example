# 阶段 6 真实服务环境变量模板
#
# 用法：
#   1. 复制为 qiantubailian-commerce/.env（不要提交到仓库）；
#   2. 填入真实密钥；
#   3. 先运行 node scripts/stage6-ready.mjs --probe，全部通过后再执行盲评。
#
# 密钥只能由掌握供应商账户的人填写。仓库和报告里不得出现明文密钥。

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# 真实生图：三臂共用同一个模型，隔离工作流差异
QTB_PROVIDER=seedream
PARATERA_API_KEY=
PILOTDECK_SEEDREAM_BASE_URL=https://llmapi.paratera.com/v1
PILOTDECK_SEEDREAM_MODEL=Doubao-Seedream-4.0
# 主体保护走本地合成；该能力尚未完成真实人工验收，报告中必须标注 not_verified
QTB_SEEDREAM_POST_COMPOSITE=1

# 视觉评审与修订规划：指向 scripts/stage6-llm-bridge.mjs
QTB_VISUAL_REVIEW_ENDPOINT=http://127.0.0.1:4100/review
QTB_VISUAL_REVIEW_MODEL=GLM-4.6V
QTB_VISUAL_REVIEW_TIMEOUT_MS=120000
QTB_REVISION_PLANNER_ENDPOINT=http://127.0.0.1:4100/plan
QTB_REVISION_PLANNER_MODEL=GLM-4.6V
QTB_REVISION_PLANNER_TIMEOUT_MS=120000

# 本地桥接（读取同一把 PARATERA_API_KEY）
QTB_STAGE6_BRIDGE_HOST=127.0.0.1
QTB_STAGE6_BRIDGE_PORT=4100
QTB_STAGE6_DEFAULT_MODEL=GLM-4.6V
QTB_STAGE6_MAX_TOKENS=8000
QTB_STAGE6_BRIDGE_TIMEOUT_MS=120000
# 可选：给桥接加 Bearer 令牌，同时写入上面两个 ENDPOINT 的 API_KEY
QTB_STAGE6_BRIDGE_TOKEN=

# OCR：未配置时文字检查按 unknown 计入，不得当成通过
QTB_OCR_ENDPOINT=
QTB_OCR_API_KEY=
QTB_OCR_MODEL=
QTB_OCR_TIMEOUT_MS=15000

QTB_INITIAL_CREDITS=240
